<!--This is the edit Country file with forms-->

<!DOCTYPE html>
<html>
<head>
  <title>Edit Country</title>
</head>
<body>
  <h1>Edit Country (ID: <%= country.country_id %>)</h1>

  <!-- Display error message if server validation fails -->
  <% if (error) { %>
    <p style="color: red;"><%= error %></p>
  <% } %>

  <!-- Form posts updates using the dynamic URL parameter ID -->
  <form action="/countries/edit/<%= country.country_id %>" method="POST">
    <label>Country Name: 
      <input type="text" name="country_name" value="<%= country.country_name %>" maxlength="30" required>
    </label><br><br>

    <label>Popular Site: 
      <input type="text" name="popular_site" value="<%= country.popular_site %>" maxlength="50" required>
    </label><br><br>

    <label>Capital: 
      <input type="text" name="capital" value="<%= country.capital %>" maxlength="30" required>
    </label><br><br>

    <label>Population: 
      <input type="number" name="population" value="<%= country.population %>" min="0" required>
    </label><br><br>

    <label>Visited (Y/N): 
      <input type="text" name="visited" value="<%= country.visited || '' %>" maxlength="1">
    </label><br><br>

    <button type="submit">Update Country</button>
  </form>

  <br>
  <a href="/countries">Cancel & Return to List</a>
</body>
</html>